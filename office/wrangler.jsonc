// Private office on Cloudflare Workers + one SQLite Durable Object. No custom domain here:
// deploying this file does not create DNS records. Run `node office/assemble.mjs` before a manual deploy.
{
  "name": "grokbot-private-office",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "OFFICE", "class_name": "Office" }]
  },
  // Served at yash.is/in-the-office/ (Worker routes on the yash.is zone, path-scoped Access app).
  // office.yash.is redirects there once OFFICE_HOME is set; its /api/ingest keeps working for bots.
  "vars": { "OFFICE_MOUNT": "/in-the-office", "OFFICE_LEGACY_HOSTS": "office.yash.is", "OFFICE_HOME": "https://yash.is/in-the-office/" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Office"] }]
}
